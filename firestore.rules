rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.clientNumber is string;
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(userId)
          && resource.data.role == 'customer'
          && request.resource.data.role == resource.data.role);
      allow delete: if isOwner(userId) || isAdmin();

      match /favorites/{productId} {
        allow read, create, update, delete: if isOwner(userId);
        allow read: if isAdmin();
      }

      match /cart/{productId} {
        allow read, create, update, delete: if isOwner(userId);
        allow read: if isAdmin();
      }
    }

    match /requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.itemCount == request.resource.data.items.size()
        && request.resource.data.clientNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientNumber
        && request.resource.data.customerPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone;
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /{path=**}/favorites/{productId} {
      allow read: if isAdmin();
    }
  }
}
